# Server environment. Keep real values out of Git and browser code.
HOST=127.0.0.1
PORT=3000
# PUBLIC_ORIGIN=https://focus.example
# TRUST_PROXY=127.0.0.1

# Account database and mail transport.
# FOCUS_AUTH_ENABLED=1
# FOCUS_AUTH_SECRET=
# FOCUS_AUTH_DB=
# FOCUS_SMTP_USER=
# FOCUS_SMTP_PASSWORD=
# FOCUS_SMTP_PORT=
# FOCUS_MAIL_FROM=
# FOCUS_POSTBOX_KEY_ID=
# FOCUS_POSTBOX_KEY_SECRET=
# FOCUS_POSTBOX_TUNNEL_PORT=

# Administrative access requires an explicit allowlist.
# FOCUS_ADMIN_EMAIL=
# FOCUS_ADMIN_ALLOWED_IPS=

# Active providers. OpenRouter takes precedence for chat when configured.
# GOOGLE_API_KEY=
# OPENROUTER_API_KEY=
# TAVILY_API_KEY=
# TAVILY_DAILY_LIMIT=30
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=
# FOCUS_OPENAI_IMAGE_API_KEY=
# OPENROUTER_IMAGE_MODEL=

# Required before provider requests. See docs/operations.md for units and tariff guidance.
# FOCUS_BUDGET_GLOBAL_DAY_TOKENS=
# FOCUS_BUDGET_GLOBAL_MONTH_TOKENS=
# FOCUS_BUDGET_USER_DAY_TOKENS=
# FOCUS_BUDGET_USER_MONTH_TOKENS=
# FOCUS_BUDGET_GLOBAL_DAY_USD_MICROS=
# FOCUS_BUDGET_GLOBAL_MONTH_USD_MICROS=
# FOCUS_BUDGET_USER_DAY_USD_MICROS=
# FOCUS_BUDGET_USER_MONTH_USD_MICROS=
