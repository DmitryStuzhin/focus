# Server-only. Never expose this variable to the client.
GOOGLE_API_KEY=
PORT=3000
HOST=127.0.0.1
# Optional. A verified Focus account with this exact email can open the admin panel.
# FOCUS_ADMIN_EMAIL=
# Production only, behind a trusted reverse proxy:
# PUBLIC_ORIGIN=https://tokenapp.ru
# TRUST_PROXY=1
# Takes precedence over Google when set. Uses free models only.
OPENROUTER_API_KEY=

# Optional server-side web search. Never include this key in public assets.
TAVILY_API_KEY=
# Global daily request budget per running process; also limited to 6/minute per IP.
TAVILY_DAILY_LIMIT=30

# Images via Cloudflare Workers AI (daily free quota on Workers Free).
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=

# Optional paid image provider when Cloudflare is not configured.
# OPENROUTER_IMAGE_MODEL=bytedance-seed/seedream-4.5
